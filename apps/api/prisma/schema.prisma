generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppState {
  id        Int      @id
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiUsageSnapshot {
  id           Int      @id @default(autoincrement())
  inputTokens  Int
  outputTokens Int
  totalTokens  Int
  createdAt    DateTime @default(now())
}

model NewsItemRecord {
  key                String   @id
  feedUrl            String
  itemId             String
  title              String
  titleBg            String?
  titleEn            String?
  coverUrl           String?
  link               String
  source             String
  published          String?
  publishedMs        BigInt
  isMatch            Boolean
  matchScore         Float
  filteredOk         Boolean
  summary            String?
  research           String?
  insightStatus      String?
  insightsJson       String?
  topicHitsJson      String?
  emergingSignalJson String?
  mood               String?
  newsType           String?
  contextText        String?
  linkText           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([feedUrl, itemId])
  @@index([feedUrl, publishedMs, itemId])
  @@index([publishedMs, itemId])
}

model User {
  id           Int               @id @default(autoincrement())
  username     String            @unique
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  providerKeys UserProviderKey[]
  settings     UserSettings?
}

model UserProviderKey {
  id           Int      @id @default(autoincrement())
  userId       Int
  provider     String
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model UserSettings {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  settingsJson String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ErrorLogRecord {
  id              Int      @id @default(autoincrement())
  category        String
  feedUrl         String?
  feedLabel       String?
  attempt         Int?
  maxAttempts     Int?
  failCount       Int?
  disabledUntilMs BigInt?
  message         String
  detailsJson     String?
  createdAt       DateTime @default(now())

  @@index([category, createdAt])
  @@index([feedUrl, createdAt])
}
